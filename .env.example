# Optional Environment Overrides for Viddy
# Note: Viddy works out-of-the-box with free local engines (Edge-TTS, FFmpeg, Brave Browser).

# Custom browser path (if Brave is installed in a non-standard path)
# BRAVE_PATH="C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe"

# Custom FFmpeg binaries (auto-detected if in PATH or WinGet)
# FFMPEG_PATH="ffmpeg"
# FFPROBE_PATH="ffprobe"

# Optional AI API keys (heuristic generators are enabled by default)
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""
# ELEVENLABS_API_KEY=""

# Optional Developer Keys for official TikTok/YouTube APIs
# TIKTOK_CLIENT_KEY=""
# TIKTOK_CLIENT_SECRET=""
# YOUTUBE_CLIENT_ID=""
# YOUTUBE_CLIENT_SECRET=""
